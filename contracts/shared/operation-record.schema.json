{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ignition-mcp:shared:operation-record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "correlationId": {"$ref": "correlation.schema.json"},
    "tool": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["in_progress", "succeeded", "failed", "outcome_unknown", "cancelled", "interrupted"]},
    "errorCode": {"type": ["string", "null"]},
    "startedAt": {"type": "string", "minLength": 1},
    "finishedAt": {"type": ["string", "null"]},
    "phases": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 64},
          "at": {"type": "string", "minLength": 1}
        },
        "required": ["name", "at"]
      }
    },
    "transactionId": {"type": ["string", "null"]},
    "downstreamCorrelationId": {"type": ["string", "null"]},
    "auditResultMissing": {"type": "boolean"}
  },
  "required": ["correlationId", "tool", "outcome", "errorCode"]
}
