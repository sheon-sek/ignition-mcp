{
  "schemaVersion": 1,
  "name": "perspective_view_list",
  "server": "ignition-rest",
  "owner": "rest",
  "stability": "experimental",
  "operationKind": "read",
  "permissionClass": "READ",
  "requiredScope": "ignition.read",
  "mutationClass": "NONE",
  "budgetClass": "ARTIFACT",
  "parameters": {
    "projectName": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 256
    },
    "limit": {
      "type": "integer",
      "required": false,
      "default": 100,
      "minimum": 1,
      "maximum": 500
    },
    "offset": {
      "type": "integer",
      "required": false,
      "default": 0,
      "minimum": 0,
      "maximum": 1000000
    }
  },
  "outputSchema": "contracts/schemas/perspective-view-list.output.schema.json",
  "nativeRequirements": [
    "GET /data/api/v1/projects/export/{name}"
  ],
  "capabilityId": "project_export",
  "localResourcesOnly": true,
  "inheritanceLookup": false,
  "exportHandling": "the export is streamed into private staging, read in place and never published as an artifact or passed through the MCP body (D15/D17)",
  "silentTruncation": false
}
