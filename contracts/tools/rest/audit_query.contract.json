      "type": "string",
      "required": false,
      "default": ""
    },
    "value": {
      "type": "string",
      "required": false,
      "default": ""
    },
    "system": {
      "type": "string",
      "required": false,
      "default": ""
    },
    "originatingContext": {
      "type": "string",
      "required": false,
      "default": ""
    },
    "startTime": {
      "type": "string",
      "required": false,
      "default": ""
