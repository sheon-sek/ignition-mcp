{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ignition-mcp:runtime:historian-query-series:output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "startTime": {"type": "string", "minLength": 1},
    "endTime": {"type": "string", "minLength": 1},
    "sampleCount": {"type": "integer", "minimum": 1},
    "points": {"type": "array", "maxItems": 25000, "items": {"type": "object", "additionalProperties": false, "properties": {"path": {"type": "string", "minLength": 1}, "timestamp": {"oneOf": [{"type": "string", "minLength": 1}, {"$ref": "#/$defs/null"}]}, "value": {"$ref": "#/$defs/value"}, "quality": {"type": "object", "additionalProperties": false, "properties": {"code": {"oneOf": [{"type": "integer"}, {"$ref": "#/$defs/null"}]}, "name": {"type": "string"}, "good": {"type": "boolean"}}, "required": ["code", "name", "good"]}}, "required": ["path", "timestamp", "value", "quality"]}},
    "summary": {"type": "object", "additionalProperties": false, "properties": {"paths": {"type": "integer", "minimum": 1, "maximum": 50}, "returnedPoints": {"type": "integer", "minimum": 0, "maximum": 25000}, "hardPointLimit": {"const": 25000}}, "required": ["paths", "returnedPoints", "hardPointLimit"]},
    "meta": {"$ref": "#/$defs/meta"}
  },
  "required": ["startTime", "endTime", "sampleCount", "points", "summary", "meta"],
  "$defs": {
    "null": {"type": "object", "properties": {"$ignition": {"const": "null"}}, "required": ["$ignition"], "additionalProperties": false},
    "value": {"oneOf": [{"type": ["string", "number", "boolean"]}, {"$ref": "#/$defs/null"}, {"type": "object", "properties": {"type": {"const": "decimal"}, "text": {"type": "string"}}, "required": ["type", "text"], "additionalProperties": false}, {"type": "object", "properties": {"type": {"const": "non-finite-number"}, "text": {"type": "string"}}, "required": ["type", "text"], "additionalProperties": false}]},
    "meta": {"type": "object", "additionalProperties": false, "properties": {"correlationId": {"type": "string", "minLength": 1}}, "required": ["correlationId"]}
  }
}
