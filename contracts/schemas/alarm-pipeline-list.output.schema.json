{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ignition-mcp:rest:alarm-pipeline-list:output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "projectName": {
            "type": "string",
            "minLength": 1
          },
          "pipelineName": {
            "type": "string",
            "minLength": 1
          },
          "itemCount": {
            "type": "integer",
            "minimum": 0
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "projectName",
          "pipelineName",
          "itemCount",
          "active"
        ]
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "matching": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "total",
        "matching",
        "limit",
        "offset"
      ]
    }
  },
  "required": [
    "correlationId",
    "items",
    "page"
  ]
}
