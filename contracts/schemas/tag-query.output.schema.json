{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ignition-mcp:runtime:tag-query:output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "properties": {
            "type": "object",
            "propertyNames": {"not": {"const": "$ignition"}},
            "additionalProperties": {"$ref": "#/$defs/value"}
          }
        },
        "required": ["path", "properties"]
      }
    },
    "continuation": {"oneOf": [{"type": "string", "minLength": 1}, {"$ref": "#/$defs/null"}]},
    "summary": {"type": "object", "additionalProperties": false, "properties": {"returned": {"type": "integer", "minimum": 0, "maximum": 500}, "limit": {"type": "integer", "minimum": 1, "maximum": 500}, "hasMore": {"type": "boolean"}}, "required": ["returned", "limit", "hasMore"]},
    "meta": {"$ref": "#/$defs/meta"}
  },
  "required": ["items", "continuation", "summary", "meta"],
  "$defs": {
    "null": {"type": "object", "properties": {"$ignition": {"const": "null"}}, "required": ["$ignition"], "additionalProperties": false},
    "value": {"oneOf": [
      {"type": ["string", "number", "boolean"]},
      {"$ref": "#/$defs/null"},
      {"type": "array", "items": {"$ref": "#/$defs/value"}},
      {"type": "object", "propertyNames": {"not": {"const": "$ignition"}}, "additionalProperties": {"$ref": "#/$defs/value"}},
      {"type": "object", "properties": {"$ignition": {"const": "object"}, "entries": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "string"}, {"$ref": "#/$defs/value"}], "minItems": 2, "maxItems": 2}}}, "required": ["$ignition", "entries"], "additionalProperties": false}
    ]},
    "meta": {"type": "object", "additionalProperties": false, "properties": {"correlationId": {"type": "string", "minLength": 1}}, "required": ["correlationId"]}
  }
}
