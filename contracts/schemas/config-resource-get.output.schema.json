  "type": "object",
  "additionalProperties": false,
  "properties": {
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "resourceType": {
      "type": "string",
      "minLength": 3
    },
    "resource": {
      "type": "object",
      "additionalProperties": true
    },
    "signature": {
      "description": "The Gateway's Resource signature, the Precondition token for this resource; null when the Gateway reports none.",
