{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ignition-mcp:rest:config-resource-names:output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "resourceType": {
      "type": "string",
      "minLength": 3
    },
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "enabled"
        ]
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "matching": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "total",
        "matching",
        "limit",
        "offset"
      ]
    }
  },
  "required": [
    "correlationId",
    "resourceType",
    "items",
    "page"
  ]
}
