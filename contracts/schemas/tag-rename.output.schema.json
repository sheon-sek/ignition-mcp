{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ignition-mcp:runtime:tag-rename:output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 3
              },
              "newPath": {
                "type": "string",
                "minLength": 3
              },
              "status": {
                "const": "executed"
              },
              "nativeOutcome": {
                "$ref": "#/$defs/quality"
              }
            },
            "required": [
              "path",
              "newPath",
              "status",
              "nativeOutcome"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 3
              },
              "newPath": {
                "type": "string",
                "minLength": 3
              },
              "status": {
                "const": "conflict"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "newPath",
              "status",
              "reason"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 3
              },
              "newPath": {
                "type": "string",
                "minLength": 3
              },
              "status": {
                "const": "outcome_unknown"
              }
            },
            "required": [
              "path",
              "newPath",
              "status"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 3
              },
              "newPath": {
                "type": "string",
                "minLength": 3
              },
              "status": {
                "const": "not_executed"
              }
            },
            "required": [
              "path",
              "newPath",
              "status"
            ]
          }
        ]
      }
    },
    "observed": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 3
              },
              "status": {
                "const": "ok"
              },
              "absent": {
                "const": true
              }
            },
            "required": [
              "path",
              "status",
              "absent"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 3
              },
              "status": {
                "const": "ok"
              },
              "absent": {
                "const": false
              },
              "fingerprint": {
                "type": "string",
                "pattern": "^tcf1:[0-9a-f]{64}$"
              },
              "configuration": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/value"
                }
              }
            },
            "required": [
              "path",
              "status",
              "absent",
              "fingerprint",
              "configuration"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 3
              },
              "status": {
                "const": "error"
              },
              "error": {
                "$ref": "#/$defs/observed_error"
              }
            },
            "required": [
              "path",
              "status",
              "error"
            ]
          }
        ]
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "outcomeUnknown": {
          "type": "integer",
          "minimum": 0
        },
        "notExecuted": {
          "type": "integer",
          "minimum": 0
        },
        "auditMode": {
          "enum": [
            "best_effort",
            "required",
            "off"
          ]
        },
        "auditRecorded": {
          "type": "boolean"
        }
      },
      "required": [
        "requested",
        "succeeded",
        "failed",
        "outcomeUnknown",
        "notExecuted",
        "auditMode",
        "auditRecorded"
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "correlationId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "correlationId"
      ]
    }
  },
  "required": [
    "items",
    "observed",
    "summary",
    "meta"
  ],
  "$defs": {
    "null": {
      "type": "object",
      "properties": {
        "$ignition": {
          "const": "null"
        }
      },
      "required": [
        "$ignition"
      ],
      "additionalProperties": false
    },
    "value": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        {
          "$ref": "#/$defs/null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "const": "$ignition"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "properties": {
            "$ignition": {
              "const": "object"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/value"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "required": [
            "$ignition",
            "entries"
          ],
          "additionalProperties": false
        }
      ]
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "integer"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "string",
          "minLength": 1
        },
        "good": {
          "type": "boolean"
        },
        "diagnosticMessage": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/null"
            }
          ]
        }
      },
      "required": [
        "code",
        "name",
        "level",
        "good",
        "diagnosticMessage"
      ]
    },
    "observed_error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "schema_mismatch",
            "upstream_error",
            "limit_exceeded"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "message",
        "correlationId"
      ]
    }
  }
}
