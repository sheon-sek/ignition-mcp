{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ignition-mcp:runtime:tag-read:output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {"type": "array", "maxItems": 500, "items": {"oneOf": [
      {"type": "object", "additionalProperties": false, "properties": {"path": {"type": "string", "minLength": 1}, "status": {"const": "ok"}, "value": {"$ref": "#/$defs/value"}, "quality": {"$ref": "#/$defs/quality"}, "timestamp": {"oneOf": [{"type": "string"}, {"type": "integer"}, {"$ref": "#/$defs/null"}]}}, "required": ["path", "status", "value", "quality", "timestamp"]},
      {"type": "object", "additionalProperties": false, "properties": {"path": {"type": "string", "minLength": 1}, "status": {"const": "error"}, "error": {"$ref": "#/$defs/error"}}, "required": ["path", "status", "error"]}
    ]}},
    "summary": {"type": "object", "additionalProperties": false, "properties": {"requested": {"type": "integer", "minimum": 1, "maximum": 500}, "succeeded": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}}, "required": ["requested", "succeeded", "failed"]},
    "meta": {"type": "object", "additionalProperties": false, "properties": {"correlationId": {"type": "string", "minLength": 1}}, "required": ["correlationId"]}
  },
  "required": ["items", "summary", "meta"],
  "$defs": {
    "null": {"type": "object", "properties": {"$ignition": {"const": "null"}}, "required": ["$ignition"], "additionalProperties": false},
    "value": {"oneOf": [
      {"type": ["string", "number", "boolean"]},
      {"$ref": "#/$defs/null"},
      {"type": "array", "items": {"$ref": "#/$defs/value"}},
      {"type": "object", "propertyNames": {"not": {"const": "$ignition"}}, "additionalProperties": {"$ref": "#/$defs/value"}},
      {"type": "object", "properties": {"$ignition": {"const": "object"}, "entries": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "string"}, {"$ref": "#/$defs/value"}], "minItems": 2, "maxItems": 2}}}, "required": ["$ignition", "entries"], "additionalProperties": false}
    ]},
    "quality": {"type": "object", "additionalProperties": false, "properties": {"code": {"type": "integer"}, "name": {"type": "string", "minLength": 1}, "level": {"type": "string", "minLength": 1}, "good": {"type": "boolean"}, "diagnosticMessage": {"oneOf": [{"type": "string"}, {"$ref": "#/$defs/null"}]}}, "required": ["code", "name", "level", "good", "diagnosticMessage"]},
    "error": {"type": "object", "additionalProperties": false, "properties": {"code": {"enum": ["schema_mismatch"]}, "message": {"type": "string", "minLength": 1}, "correlationId": {"type": "string", "minLength": 1}}, "required": ["code", "message", "correlationId"]}
  }
}
