root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[packages/ignition-runtime-bundle/project/**/onToolCalled.py]
indent_style = tab

[packages/ignition-runtime-bundle/project/**/onPrompt.py]
indent_style = tab

[*.{json,yaml,yml,toml}]
indent_style = space
indent_size = 2
